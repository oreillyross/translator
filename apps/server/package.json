{
  "name": "@translator/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/vocabulary && cp src/vocabulary/*.yml dist/vocabulary/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for server'",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.2",
    "@trpc/server": "^11.0.0-rc.502",
    "@translator/db": "workspace:*",
    "@translator/shared": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.1.0",
    "resend": "^4.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
